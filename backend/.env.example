# backend/.env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medicare?retryWrites=true&w=majority

# JWT (doctor login)
JWT_SECRET=<strong-random-secret-min-32-chars>

# Clerk (authentication)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...

# ElevenLabs Voice Agents
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_CONCIERGE_AGENT_ID=
ELEVENLABS_APPOINTMENT_AGENT_ID=
ELEVENLABS_DOCTOR_AGENT_ID=
ELEVENLABS_DIAGNOSTIC_AGENT_ID=
ELEVENLABS_EMERGENCY_AGENT_ID=
ELEVENLABS_BED_AGENT_ID=
ELEVENLABS_STAFF_AGENT_ID=
ELEVENLABS_OT_AGENT_ID=
ELEVENLABS_EQUIPMENT_AGENT_ID=
ELEVENLABS_FORECAST_AGENT_ID=
ELEVENLABS_PATIENT_AGENT_ID=
ELEVENLABS_ADMIN_AGENT_ID=

# N8N Service Authentication
# Generate with: openssl rand -hex 32
MNX_SERVICE_KEY=<generate-strong-random-key-never-share>

# Frontend (for CORS)
FRONTEND_URL=https://medi-nexus-rhl.netlify.app
